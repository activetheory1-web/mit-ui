# Database
DATABASE_URL="postgresql://user:password@localhost:5432/mip_db"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# Server
PORT=3001
NODE_ENV=development

# AI Engine — Grok (xAI) API  (replaces Claude)
# Get your key from: https://console.x.ai
GROK_API_KEY="your-grok-api-key"

# Legacy (kept for reference — not used)
# CLAUDE_API_KEY="your-claude-api-key"

# CORS
FRONTEND_URL="http://localhost:5173"

# Rate Limiting (requests per minute)
RATE_LIMIT_GLOBAL=100
RATE_LIMIT_AUTH=5
RATE_LIMIT_AI=10

# Meta Ads API (for OAuth flow - per-user tokens stored in DB)
META_APP_ID="your-meta-app-id"
META_APP_SECRET="your-meta-app-secret"

# Google Ads API (for OAuth flow)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GOOGLE_DEVELOPER_TOKEN="your-developer-token"

# Microsoft Fabric SQL Analytics Endpoint
FABRIC_SQL_SERVER="xyz.datawarehouse.fabric.microsoft.com"
FABRIC_DATABASE="mip_lakehouse"

# Azure Service Principal (For Auth & Pipeline Triggering)
AZURE_TENANT_ID="your_tenant_id"
AZURE_CLIENT_ID="your_client_id"
AZURE_CLIENT_SECRET="your_client_secret"
FABRIC_WORKSPACE_ID="your_workspace_id"
FABRIC_META_PIPELINE_ID="your_meta_pipeline_id"
FABRIC_GOOGLE_PIPELINE_ID="your_google_pipeline_id"